# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env faylni HECH QACHON GitHub'ga yuklamang va chatga yozmang.

# @BotFather bergan token
BOT_TOKEN=

# Adminlar Telegram ID'lari (vergul bilan). ID'ni @userinfobot orqali bilasiz.
ADMIN_IDS=123456789

# To'lov uchun karta (mijozga ko'rsatiladi)
PAY_CARD=8600 0000 0000 0000
PAY_CARD_OWNER=RAKHIMOV A.

# ---- Yupay ----
# Yupay > Yana > Sozlamalar > API kalitlari (yangi kalit!)
YUPAY_API_KEY=
YUPAY_BASE_URL=https://reseller.yupay.uz/api/v1

# Quyidagi yo'llar Yupay API hujjatiga qarab to'g'rilanadi:
YUPAY_PATH_BALANCE=/balance
YUPAY_PATH_PRODUCTS=/products
YUPAY_PATH_CREATE_ORDER=/orders
YUPAY_PATH_ORDER=/orders/{order_id}
# Buyurtmada o'yinchi ID'si qaysi maydon nomi bilan yuboriladi
YUPAY_PLAYER_FIELD=player_id

# ---- Vebhuk (Yupay buyurtma holatini shu manzilga yuboradi) ----
# Yupay > Vebhuklar ga yoziladigan manzil: https://SIZNING-DOMEN/yupay/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/yupay/webhook
